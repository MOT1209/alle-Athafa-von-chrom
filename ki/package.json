{
  "name": "videomind-ai",
  "private": true,
  "version": "0.1.0",
  "description": "VideoMind AI - local-first AI video knowledge extension for Chrome (MV3). Zero paid API dependency.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/live-test.mjs",
    "icons": "node scripts/icons.mjs",
    "e2e": "node scripts/e2e.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@wxt-dev/module-react": "^1.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
