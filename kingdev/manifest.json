{
  "manifest_version": 3,
  "name": "KingDev",
  "version": "0.1.0",
  "description": "The AI developer operating layer for the browser — capture errors, network traffic and page context, then debug with evidence.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/kingdev-16.png",
    "48": "icons/kingdev-48.png",
    "128": "icons/kingdev-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "options_ui": {
    "page": "options.html"
  },
  "action": {
    "default_title": "KingDev"
  },
  "permissions": ["storage"],
  "optional_permissions": ["scripting"],
  "host_permissions": [],
  "optional_host_permissions": ["<all_urls>"]
}
